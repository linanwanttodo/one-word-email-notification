# 通知方式，多个用逗号分隔（如：serverchan,email）
NOTIFY_TYPE=serverchan,email

# 一言来源（apihz / hitokoto，默认 apihz）
# YIYAN_SOURCE=apihz

# 接口盒子（apihz）配置，仅 YIYAN_SOURCE=apihz 时需要
# 申请地址: https://www.apihz.cn/
YIYAN_API_ID=
YIYAN_API_KEY=

# hitokoto 源无需任何配置，YIYAN_SOURCE=hitokoto 时上面两项可留空

# Server酱 配置
SERVERCHAN_KEY=

# 邮件配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
